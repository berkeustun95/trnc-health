{
  "name": "ada",
  "version": "1.0.0",
  "main": "index.js",
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/playfair-display": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@supabase/supabase-js": "^2.106.2",
    "babel-preset-expo": "~54.0.10",
    "expo": "~54.0.37",
    "expo-apple-authentication": "~8.0.8",
    "expo-blur": "~15.0.8",
    "expo-constants": "~18.0.14",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.20",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-maps": "1.20.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-webview": "13.15.0",
    "supercluster": "^9.0.0",
    "zustand": "^5.0.14"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "check:flags": "node scripts/check-module-flags.mjs",
    "ads:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-ad-placement.mjs",
    "ads:selftest": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-ad-placement.mjs --self",
    "ota": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-ota-preflight.mjs && node scripts/check-module-flags.mjs && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-terms-commitment.mjs && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-privacy-parity.mjs && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-hero-logo.mjs && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-home-geometry.mjs && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-tile-labels.mjs && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-hero-contrast.mjs && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-i18n-duplicates.mjs && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-component-refs.mjs && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-ad-placement.mjs && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-native-import-safety.mjs && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-pets-staleness.mjs && eas update --channel production",
    "setup:hooks": "git config core.hooksPath .githooks && echo 'hooks enabled (.githooks)'",
    "eas-build-pre-install": "node scripts/check-module-flags.mjs",
    "ios:build": "set -a && . ~/.appstoreconnect/ada-eas.env && set +a && npx -y eas-cli@24.7.0 build --platform ios --profile production --non-interactive --no-wait",
    "ios:submit": "set -a && . ~/.appstoreconnect/ada-eas.env && set +a && npx -y eas-cli@24.7.0 submit --platform ios --profile production --latest --non-interactive",
    "check:secrets": "node scripts/check-secrets.mjs",
    "conn:health": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-connectivity-content.mjs",
    "native:safe": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-native-import-safety.mjs",
    "explore:validate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/validate-photo-attribution.mjs && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/validate-explore-seed.mjs",
    "explore:seed": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/seed-explore-photos.mjs",
    "novest:validate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/validate-novest-mapping.mjs --self",
    "novest:import": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/import-novest-properties.mjs",
    "novest:images": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/mirror-novest-images.mjs",
    "novest:verify": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify-novest-import.mjs",
    "novest:health": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-novest-staleness.mjs",
    "novest:logo": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/upload-novest-logo.mjs",
    "map:validate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/validate-map-sources.mjs",
    "weather:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-weather-normalize.mjs",
    "drift:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/audit-schema-drift.mjs --check",
    "drift:regen": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/audit-schema-drift.mjs",
    "migration:next": "node scripts/check-migration-numbers.mjs --next",
    "check:migration-numbers": "node scripts/check-migration-numbers.mjs",
    "partners:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-partner-assets.mjs",
    "preview:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-partner-preview.mjs",
    "dorms:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-dorms.mjs",
    "pethotel:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-pet-partners.mjs",
    "refs:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-component-refs.mjs",
    "refs:selftest": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-component-refs.mjs --self",
    "i18n:validate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-i18n-duplicates.mjs && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/validate-i18n-coverage.mjs",
    "i18n:dupes": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-i18n-duplicates.mjs",
    "pets:health": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-pets-staleness.mjs",
    "legal:live": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-legal-live.mjs",
    "duty:health": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-duty-staleness.mjs",
    "institutions:links": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-institution-links.mjs",
    "notify:health": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-notify-health.mjs",
    "terms:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-terms-commitment.mjs",
    "moderation:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-moderation-normalization.mjs",
    "moderation:log": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-moderation-log.mjs",
    "profile:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-profile-gate.mjs",
    "audits:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-dev-audits.mjs",
    "web:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-web-assets.mjs",
    "web:deploy": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-web-assets.mjs && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-privacy-parity.mjs && npx wrangler deploy",
    "privacy:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-privacy-parity.mjs",
    "logo:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-hero-logo.mjs",
    "home:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-home-geometry.mjs",
    "hero:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-hero-contrast.mjs",
    "labels:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-tile-labels.mjs"
  },
  "private": true,
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/react": "~19.1.10",
    "babel-plugin-module-resolver": "^5.0.3",
    "sharp": "^0.35.3",
    "typescript": "~5.9.2"
  }
}
