{
  "name": "ada",
  "version": "1.0.0",
  "main": "index.js",
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/playfair-display": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@supabase/supabase-js": "^2.106.2",
    "babel-preset-expo": "~54.0.10",
    "expo": "^54.0.35",
    "expo-blur": "~15.0.8",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.18",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-maps": "1.20.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-url-polyfill": "^3.0.0",
    "zustand": "^5.0.14"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "check:flags": "node scripts/check-module-flags.mjs",
    "ota": "node scripts/check-module-flags.mjs && eas update --channel production",
    "setup:hooks": "git config core.hooksPath .githooks && echo 'hooks enabled (.githooks)'",
    "eas-build-pre-install": "node scripts/check-module-flags.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "explore:validate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/validate-photo-attribution.mjs",
    "novest:validate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/validate-novest-mapping.mjs --self",
    "novest:import": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/import-novest-properties.mjs",
    "novest:images": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/mirror-novest-images.mjs",
    "novest:verify": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify-novest-import.mjs",
    "novest:health": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-novest-staleness.mjs",
    "novest:logo": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/upload-novest-logo.mjs"
  },
  "private": true,
  "devDependencies": {
    "@types/react": "~19.1.10",
    "babel-plugin-module-resolver": "^5.0.3",
    "sharp": "^0.35.3",
    "typescript": "~5.9.2"
  }
}
