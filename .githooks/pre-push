#!/bin/sh
# Dark-launch flag guard. Blocks a push that would ship a gated module.
#
# NOTE THE LIMIT, it matters: this fires on `git push` ONLY. It does NOT fire on
# `eas update`, and eas update bundles the WORKING TREE — so an uncommitted flag flip
# ships to production without ever touching git. Use `npm run ota`, which runs the same
# guard before publishing. See scripts/check-module-flags.mjs.
node scripts/check-module-flags.mjs || {
  echo "  push blocked: revert the flag, or update the guard baseline if launching."
  exit 1
}

# Secret guard. Blocks a push that would publish a service_role key, a Supabase secret
# key, or a connection string with a password. Added after a live service_role JWT was
# pasted into supabase/functions/sync-novest/schedule.sql while substituting the cron
# placeholders — it was caught only because that file happened to be untracked.
#
# The anon key is deliberately NOT flagged: it is bound by RLS and ships in the bundle by
# design. The rule matches the service_role payload, not the JWT shape.
node scripts/check-secrets.mjs || {
  echo "  push blocked: remove the credential, then ROTATE it."
  exit 1
}

# Migration-number guard. Blocks a push where one migration prefix is taken by two
# different files on ANY local or origin/* branch (or the working tree). The old rule,
# `ls supabase/migrations | tail -1`, sees one branch — which is how 20261046 had to skip
# a 20261045 living on another. Git only: anon cannot read the prod ledger.
node scripts/check-migration-numbers.mjs || {
  echo "  push blocked: renumber the unapplied file — npm run migration:next"
  exit 1
}

# Explore map pin-source gate. Blocks a push where the map would draw a dark module's
# content — a leak no flag guard sees, because the flag is still false and only the
# CONSUMER of it is wrong. See the header of scripts/validate-map-sources.mjs.
node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/validate-map-sources.mjs || {
  echo "  push blocked: the Explore map would publish gated content."
  exit 1
}

# Weather (MET Norway): the normaliser's local-day grouping and the symbol → icon/label map.
# Neither is visible on a device until the weather happens to be that weather.
node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-weather-normalize.mjs || {
  echo "pre-push: weather normaliser check failed — see above." >&2
  exit 1
}

# i18n coverage. Blocks a push where a locale silently renders ENGLISH — which is what
# happens when a key is missing, because t() falls back to English BEFORE it falls back
# to the key. No existence check can see that; only a value comparison can.
node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/validate-i18n-coverage.mjs || {
  echo "  push blocked: a locale would render English text."
  exit 1
}

# Terms 24h-commitment guard. Blocks a push where either copy of the Terms promises
# removal within 24 hours while no migration granting admins a real UPDATE path on
# reviews/questions/answers has been written. docs/ publishes via GitHub Pages ON PUSH,
# so `git push` IS the publish action for the hosted copy — and the in-app copy was
# already making the promise unbacked for weeks before anything compared the two.
# Checks COMMITTED, not APPLIED: only the anon key exists here, so pg_policies is out of
# reach. verify_schema.sql owns the applied half. See the script header.
# A native module imported at the top of a file runs requireNativeModule while the BUNDLE
# IS EVALUATED — at launch, on every device — so an OTA carrying one crashes every binary
# built before that module was added. runtimeVersion 'appVersion' does not fence them.
# See the header of scripts/check-native-import-safety.mjs.
node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-native-import-safety.mjs || {
  echo "pre-push BLOCKED: a guarded native module is imported at module scope."
  exit 1
}

node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-terms-commitment.mjs || {
  echo "  push blocked: the Terms promise 24h removal that the database cannot deliver."
  exit 1
}

# Ad placement. Blocks a push that would mount an advert on a surface the permanent
# exclusion list forbids — duty pharmacy, emergency contacts, health facilities, search
# results, push notifications, Ask Oli — or point one at an excluded destination.
#
# A slot id cannot encode that rule: `detail_footer` on a facility profile is a valid slot
# id and a forbidden placement, and every CHECK constraint in the migration stays green.
# Only a file path identifies a surface, so this is a mount-point allowlist. It also fails
# if the slot/route vocabularies in constants/ads.js and the migration disagree.
# `npm run ads:selftest` proves every one of its checks can go red.
# Component references — a file that PARSES but does not RESOLVE. An undefined component is
# a runtime ReferenceError, so the screen crashes on first render and no syntax check sees
# it coming; this repo shipped exactly that on 2026-09-10 when a scripted edit deleted three
# components a screen still referenced. `npm run refs:selftest` proves it can go red AND
# that its five known false-positive classes stay clean.
node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-component-refs.mjs || {
  echo "  push blocked: a JSX component reference does not resolve."
  exit 1
}

node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-ad-placement.mjs || {
  echo "  push blocked: an advert would land on an excluded surface."
  exit 1
}

# Privacy parity — WARN ONLY, deliberately. Three copies of one privacy document publish
# by three different actions: docs/ on this push, web/ via `npm run web:deploy`, the
# LegalScreen const via `npm run ota`. A push therefore publishes ONE of the three, and
# the in-app copy sitting committed-but-unshipped is a NORMAL state, not drift. Blocking
# on it would make this hook red on a correct repo, and a hook that cries wolf gets
# disabled — which costs more than the check is worth.
#
# It FAILS (exit 1) inside web:deploy and ota, where drift becomes visible to a user.
# Note what it can and cannot see: it compares the three FILES, never the three URLs.
# Schema drift audit freshness. supabase/schema_drift_audit.sql is GENERATED from every
# DDL statement in supabase/migrations/, and it went three migrations stale (1007, 1008,
# 1009) with nothing anywhere saying so. A stale drift report is worse than none: it is
# what you run FIRST against a database you are unsure about, so it answers confidently
# about a schema that no longer exists.
#
# BLOCKING, not a warning, and the distinction is the privacy-parity note above. That one
# warns because a committed-but-unshipped copy is a NORMAL state, so blocking would make
# this hook red on a correct repo. This one has no normal stale state: the artifact is
# derived from files in the same commit, so if it disagrees, the commit is wrong. There is
# nothing to cry wolf about.
#
# It re-parses every migration and compares the WHOLE emitted artifact — derived, so it
# cannot go green by forgetting one. Writes nothing.
node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/audit-schema-drift.mjs --check || {
  echo "  push blocked: the drift audit no longer matches supabase/migrations/."
  echo "               npm run drift:regen   then include the file in this commit."
  exit 1
}

# Pets content staleness — WARN ONLY, and deliberately, for the reason CLAUDE.md already
# records about check-duty-staleness and check-novest-staleness: "a push must not be
# blocked because a roster is running low; that is data operations, and a guard that
# blocks unrelated work gets disabled." A disabled guard protects nobody.
#
# It FAILS (exit 1) inside `npm run ota`, which is where stale content actually reaches a
# user. Same split as the privacy-parity line below, for the same reason — except that one
# has a NORMAL stale state (a committed-but-unshipped copy) and this one does not: the
# content really is out of date, and the fix really is one phone call.
#
# The pets module is live to every user and tells people what paperwork to bring to a
# border. Every other check in this repo asks whether a column EXISTS; this asks whether
# the CONTENT IS CURRENT, which is the question the duty roster taught us nobody was asking.
node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-pets-staleness.mjs --warn

node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-privacy-parity.mjs --warn
