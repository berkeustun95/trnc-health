#!/bin/sh
# Dark-launch flag guard. Blocks a push that would ship a gated module.
#
# NOTE THE LIMIT, it matters: this fires on `git push` ONLY. It does NOT fire on
# `eas update`, and eas update bundles the WORKING TREE — so an uncommitted flag flip
# ships to production without ever touching git. Use `npm run ota`, which runs the same
# guard before publishing. See scripts/check-module-flags.mjs.
node scripts/check-module-flags.mjs || {
  echo "  push blocked: revert the flag, or update the guard baseline if launching."
  exit 1
}

# Secret guard. Blocks a push that would publish a service_role key, a Supabase secret
# key, or a connection string with a password. Added after a live service_role JWT was
# pasted into supabase/functions/sync-novest/schedule.sql while substituting the cron
# placeholders — it was caught only because that file happened to be untracked.
#
# The anon key is deliberately NOT flagged: it is bound by RLS and ships in the bundle by
# design. The rule matches the service_role payload, not the JWT shape.
node scripts/check-secrets.mjs || {
  echo "  push blocked: remove the credential, then ROTATE it."
  exit 1
}

# Explore map pin-source gate. Blocks a push where the map would draw a dark module's
# content — a leak no flag guard sees, because the flag is still false and only the
# CONSUMER of it is wrong. See the header of scripts/validate-map-sources.mjs.
node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/validate-map-sources.mjs || {
  echo "  push blocked: the Explore map would publish gated content."
  exit 1
}

# i18n coverage. Blocks a push where a locale silently renders ENGLISH — which is what
# happens when a key is missing, because t() falls back to English BEFORE it falls back
# to the key. No existence check can see that; only a value comparison can.
node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/validate-i18n-coverage.mjs || {
  echo "  push blocked: a locale would render English text."
  exit 1
}

# Terms 24h-commitment guard. Blocks a push where either copy of the Terms promises
# removal within 24 hours while no migration granting admins a real UPDATE path on
# reviews/questions/answers has been written. docs/ publishes via GitHub Pages ON PUSH,
# so `git push` IS the publish action for the hosted copy — and the in-app copy was
# already making the promise unbacked for weeks before anything compared the two.
# Checks COMMITTED, not APPLIED: only the anon key exists here, so pg_policies is out of
# reach. verify_schema.sql owns the applied half. See the script header.
node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-terms-commitment.mjs || {
  echo "  push blocked: the Terms promise 24h removal that the database cannot deliver."
  exit 1
}
