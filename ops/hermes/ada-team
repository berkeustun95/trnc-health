#!/bin/bash
# Hermes → ADA agent team bridge. Installed root-owned at /usr/local/bin/ada-team. The gateway (user
# hermes) calls it; it re-executes itself as the team user `adateam` (sudoers 50-hermes), which cannot
# write the gateway's files, the claude binary or this script.
#   ada-team status            current main / feat/voice-input commits + the agents
#   ada-team run "<request>"   hands the request to Claude Code's principal-engineer in ~/ada;
#                              prints the team's final message, then every report file the job wrote
#                              to ~/ada/reports (run it with background=true). The gateway cannot read
#                              /home/adateam, so this output is its only copy of the full report.
#                              The report sections are also sent to Berke on Telegram directly with
#                              `hermes send` (no LLM in between: the 2026-10-13 test showed the gateway's
#                              model rewrites the report it relays, 1.4k chars in, 798 out).
set -euo pipefail
TEAM=adateam
if [[ "$(id -un)" != "$TEAM" && "${1:-}" == run ]]; then
  # Gateway side (user hermes): the job runs as adateam; its full-report sections go out verbatim.
  # The recipient is the gateway's single allowed Telegram user, never a value from the job.
  # Job text is untrusted: Hermes uploads any `MEDIA:<path>` it sees AS hermes (a report line naming
  # ~/.hermes/.env would send the bot token) and obeys [[as_document]]/[[audio_as_voice]]. A WORD
  # JOINER (U+2060, invisible) after MEDIA and between [[ breaks both, for hermes send AND for the
  # gateway's model, which runs the same extraction on its replies.
  log=$(mktemp); trap 'rm -f "$log"' EXIT
  rc=0; sudo -n -u "$TEAM" /usr/local/bin/ada-team "$@" \
    | perl -CSD -pe 's/(MEDIA)(?=\s*:)/$1\x{2060}/gi; s/\[(?=\[)/[\x{2060}/g' | tee "$log" || rc=$?
  if grep -q '^===== full report: ' "$log"; then
    to=$(sed -n 's/^TELEGRAM_ALLOWED_USERS=\([0-9][0-9]*\)$/\1/p' /home/hermes/.hermes/.env 2>/dev/null)
    if [[ "$to" =~ ^[0-9]+$ ]] && sed -n '/^===== full report: /,$p' "$log" \
         | /home/hermes/.local/bin/hermes send --to "telegram:$to" --quiet --file - >/dev/null 2>&1; then
      echo "(full report sent to Berke on Telegram directly)"
    else
      echo "(full report NOT sent directly: relay it in full)"
    fi
  fi
  exit "$rc"
fi
[[ "$(id -un)" == "$TEAM" ]] || exec sudo -n -u "$TEAM" /usr/local/bin/ada-team "$@"
export HOME=/home/$TEAM PATH=/usr/local/sbin:/usr/local/bin:/usr/bin:/bin
cd "$HOME"
REPO=$HOME/ada; JOBS=$HOME/ada-jobs
case "${1:-}" in
  status)
    git -C "$REPO" fetch -q origin
    echo "main:             $(git -C "$REPO" log -1 --format='%h %s (%cr)' origin/main)"
    echo "feat/voice-input: $(git -C "$REPO" log -1 --format='%h %s (%cr)' origin/feat/voice-input)"
    echo "agents (origin/main .claude/agents):"
    git -C "$REPO" ls-tree --name-only origin/main .claude/agents/ | sed 's#.*/##; s#\.md$##; s#^#  - #'
    ;;
  run)
    shift; req="$*"
    [[ ${#req} -ge 3 ]] || { echo "usage: ada-team run \"<request>\""; exit 2; }
    id=$(date +%Y%m%d-%H%M%S); out=$JOBS/$id.md; report=$REPO/reports/job-$id.md
    git -C "$REPO" fetch -q origin
    # The team runs on the agents Berke merged: edits to .claude/agents happen in a worktree on agent/*.
    drift=$( { git -C "$REPO" diff --name-only HEAD -- .claude/agents
               git -C "$REPO" ls-files --others -- .claude/agents; } | sort -u | tr '\n' ' ')
    git -C "$REPO" restore --source=HEAD --staged --worktree -- .claude/agents
    git -C "$REPO" clean -fdxq -- .claude/agents
    [[ -z "$(git -C "$REPO" status --porcelain --untracked-files=no)" ]] && git -C "$REPO" checkout -q main && git -C "$REPO" merge -q --ff-only origin/main || true
    git -C "$REPO" restore --source=origin/main --staged --worktree -- .claude/agents
    if [[ -n "$(git -C "$REPO" diff --name-only origin/main -- .claude/agents)$(git -C "$REPO" diff --cached --name-only origin/main -- .claude/agents)$(git -C "$REPO" ls-files --others -- .claude/agents)" ]]; then
      echo "REFUSED: .claude/agents in $REPO still differs from origin/main after the reset"; exit 1
    fi
    echo "$req" > "$JOBS/$id.request"
    : > "$out"
    [[ -z "$drift" ]] || echo "(reset .claude/agents to origin/main before this run; discarded: $drift)" >> "$out"
    cd "$REPO"
    timeout 3h /usr/local/bin/claude -p --agent principal-engineer --permission-mode dontAsk --output-format text \
"Request from Berke via Telegram (job $id). You are on the Hermes server: follow the 'Hermes server' section of CLAUDE.md and release-engineer's 'On the Hermes server' flow (agent/* branches, wrappers, no production). If you need a decision from Berke, stop and end your report with ONE question. Write your full report to $report.

$req" >> "$out" 2> "$JOBS/$id.err" || echo "(team run exited with code $? — see $JOBS/$id.err)" >> "$out"
    echo "job $id"; cat "$out"
    # -newer the .request file: written just before the run, so only this job's reports qualify.
    found=0
    while IFS= read -r -d '' f; do
      found=1; printf '\n===== full report: reports/%s =====\n' "${f##*/}"; cat "$f"
    done < <(find "$REPO/reports" -maxdepth 1 -type f -name '*.md' -newer "$JOBS/$id.request" -print0 2>/dev/null | sort -z)
    [[ $found == 1 ]] || printf '\n(no report file written to %s/reports during job %s)\n' "$REPO" "$id"
    ;;
  *) echo "usage: ada-team status | ada-team run \"<request>\""; exit 2 ;;
esac
