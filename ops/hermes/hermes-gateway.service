[Unit]
Description=Hermes Agent gateway — ADA Telegram front door (@ada_dev_team_bot)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=simple
User=hermes
Group=hermes
WorkingDirectory=/home/hermes
Environment=HOME=/home/hermes
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/bin:/bin:/home/hermes/bin:/home/hermes/.local/bin
# root: refresh ~/.hermes/.env (bot token, API key, allowlist = Berke) and Claude Code's key file
ExecStartPre=+/usr/local/sbin/ada-sync-hermes-env
ExecStart=/home/hermes/.local/bin/hermes gateway run --replace
Restart=always
RestartSec=10
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
