#!/bin/bash
# ─── ada-pr: open, comment on or close a pull request from an agent branch (never merge) ───────
#
#   sudo -n ada-pr agent/<slug> main|feat/voice-input "<title>" < body.md
#   sudo -n ada-pr comment <number> < body.md
#   sudo -n ada-pr close <number> "<comment>"
#
# Same root-only token as ada-migrate. Merging stays Berke's: the ruleset requires a PR on
# main / feat/voice-input / release/**, and this token has no Contents write. comment and close
# act only on PRs whose head is an agent/* branch of this repo; close never deletes the branch
# (the production OTA's lineage check fetches the Preview's commit).
set -euo pipefail
umask 077
REPO=berkeustun95/trnc-health
die() { echo "REFUSED: $*" >&2; exit 1; }

GH_TOKEN=$(sed -n 's/^GITHUB_DISPATCH_TOKEN=//p' /etc/ada/github.env 2>/dev/null || true)
[[ -n "$GH_TOKEN" ]] || die "/etc/ada/github.env has no GITHUB_DISPATCH_TOKEN"
export GH_TOKEN GH_PROMPT_DISABLED=1

agent_pr() {
  [[ "$1" =~ ^[1-9][0-9]{0,5}$ ]] || die "PR number must be digits"
  local head
  head=$(gh pr view "$1" -R "$REPO" --json headRefName,isCrossRepository \
    -q 'if .isCrossRepository then "" else .headRefName end') || die "cannot read PR #$1"
  [[ "$head" =~ ^agent/ ]] || die "PR #$1 head '$head' is not an agent/* branch of $REPO"
}

case "${1:-}" in
  comment)
    [[ $# -eq 2 ]] || die "usage: ada-pr comment <number> < body"
    agent_pr "$2"
    body=$(head -c 20000)
    [[ -n "${body//[[:space:]]/}" ]] || die "empty comment body"
    gh pr comment "$2" -R "$REPO" --body "$body"
    ;;
  close)
    [[ $# -eq 3 ]] || die "usage: ada-pr close <number> \"<comment>\""
    agent_pr "$2"
    [[ ${#3} -ge 3 && ${#3} -le 500 && "$3" != *[$'\x01'-$'\x1f']* ]] || die "comment must be 3–500 printable characters"
    gh pr close "$2" -R "$REPO" --comment "$3"
    ;;
  *)
    head=${1:-}; base=${2:-}; title=${3:-}
    [[ $# -eq 3 ]] || die "usage: ada-pr agent/<slug> main|feat/voice-input \"<title>\" < body | comment <n> < body | close <n> \"<comment>\""
    [[ "$head" =~ ^agent/[a-z0-9][a-z0-9._-]{0,63}$ ]] || die "head must be an agent/* branch"
    [[ "$base" == main || "$base" == feat/voice-input ]] || die "base must be main or feat/voice-input"
    [[ ${#title} -ge 5 && ${#title} -le 120 && "$title" != *[$'\x01'-$'\x1f']* ]] || die "title must be 5–120 printable characters"
    body=$(head -c 20000)
    gh pr create -R "$REPO" --head "$head" --base "$base" --title "$title" --body "$body"
    ;;
esac
